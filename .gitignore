# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Pastas de compilação com outro nome (`next build --distDir`), usadas por
# medições de antes/depois. São produto de compilação, nunca fonte — e sem esta
# linha entram no `git status` e podem ser gravadas por engano.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Playwright MCP screenshot/console artifacts
.playwright-mcp/

# Stray scratch screenshots at the repo root (never commit these; real images
# live under public/). Root-anchored so public/**/*.png is unaffected.
/*.png
/*.jpg
/*.jpeg

# Claude Code worktree artefacts (internos, não versionar)
.claude/worktrees/

# Remotion footage/render — vídeos pesados que excedem o limite do GitHub (>100MB)
remotion/public/*.mp4

# Miniaturas da galeria pré-geradas no build (scripts/pregen-gallery.mjs).
# ~166MB / 2135 ficheiros WebP. NÃO se versionam: WebP é incompressível (medido:
# tar|gzip -1 poupa 0,2%), por isso o git ficaria com 166MB de blobs para
# sempre, por cima dos 271MB que public/imagens já tem — e o build regenera-as
# de graça (e reaproveita-as de .next/cache entre builds). Os heróis, que são 24
# ficheiros / 2,7MB, continuam versionados em public/_img.
/public/_img/g/

# Ad-hoc scratch / audit / verification scripts at the repo root — not versioned
/*.mjs
!/eslint.config.mjs
!/postcss.config.mjs

# Agent skills installed via `skills add` (build-time tooling, not site code)
.agents/
.claude/skills/
skills-lock.json

# Exportação das landing pages (imagens geradas; ver scripts/exportar-lps.mjs)
lp-export/

# Pasta pronta a publicar no Instagram (imagens copiadas; ver scripts/exportar-instagram.mjs)
instagram-export/

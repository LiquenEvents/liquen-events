{
  "name": "liquen-events",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run pregen && next dev",
    "pregen": "node scripts/pregen-heroes.mjs && node scripts/pregen-gallery.mjs && node scripts/pregen-logos.mjs",
    "build": "node scripts/pregen-heroes.mjs && node scripts/pregen-gallery.mjs && node scripts/pregen-logos.mjs && next build && node scripts/folhas-que-existem.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:passkeys": "playwright test --config playwright.passkeys.config.ts",
    "test:e2e:propostas": "playwright test --config playwright.propostas.config.ts",
    "test:e2e:movel": "playwright test --config playwright.movel.config.ts",
    "test:e2e:dados": "playwright test --config playwright.dados.config.ts",
    "test:e2e:toque": "playwright test --config playwright.toque.config.ts",
    "measure:fluidity": "playwright test fluidity",
    "lh": "lhci autorun --config=lighthouserc.json",
    "lh:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "gen:blur": "node scripts/gen-blur.mjs",
    "gen:dims": "node scripts/gen-image-dims.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "gen:favicons": "node scripts/gen-favicons.mjs",
    "gallery:sync": "node scripts/gallery-sync.mjs",
    "gen:totp": "node scripts/gen-totp.mjs",
    "analyze": "ANALYZE=true next build",
    "compress:images": "node scripts/compress-sources.mjs",
    "upload:images": "node scripts/upload-images-to-supabase.mjs",
    "warm:cache": "node scripts/warm-image-cache.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.4",
    "nodemailer": "^10.0.2",
    "ogl": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "web-vitals": "^6.2.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss": "^8.5.10",
    "deepmerge-ts": "^8.0.1"
  }
}

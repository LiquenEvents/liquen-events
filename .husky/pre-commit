#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# OS DADOS LOCAIS NÃO ENTRAM NUM COMMIT POR ACIDENTE
# ═══════════════════════════════════════════════════════════════════════════
#
# Os ficheiros em `data/` são o armazenamento local — o que a aplicação usa
# quando não há base de dados configurada. O conjunto de testes ESCREVE neles
# ao correr, e um servidor de desenvolvimento também.
#
# O que aconteceu (e é por isso que isto existe): um `git add -A` levou treze
# desses ficheiros num commit que era sobre limites de tempo em rotas. Cinco
# alterados por uma passagem de testes, oito criados do zero. Nada disso é uma
# alteração de código, e ninguém os quis ali.
#
# Não se recusa o commit — há alturas em que mexer nos dados de exemplo é
# mesmo a intenção. Avisa-se, com os nomes à frente, para a pessoa poder
# desfazer antes de gravar. Um aviso é o suficiente quando o problema é
# distracção e não intenção.
#
# ── E NO REPOSITÓRIO ELES ESTÃO VAZIOS DE PROPÓSITO ────────────────────────
#
# Estiveram commitados com dados de exemplo (um pedido da "Maria Teste", uma
# tarefa, e um RASCUNHO de proposta inteiro dentro do `app-state.json`), e isso
# tinha duas consequências más:
#
#   • numa instalação em produção SEM base de dados, o que se lê é essa
#     fotografia congelada — e ela volta a aparecer a cada deploy, por cima do
#     que tiver sido escrito entretanto. Parece que "os dados voltaram atrás";
#   • em qualquer máquina, um `git checkout` de outro ramo escreve por cima do
#     `data/app-state.json` local — ou seja, por cima dos rascunhos de quem
#     estiver a trabalhar sem base de dados.
#
# Por isso o conteúdo commitado é `[]` / `{}`. Se um commit os traz com
# REGISTOS lá dentro, é quase de certeza resíduo de uma passagem de testes ou
# de uma tarde de desenvolvimento — não uma alteração que alguém queira gravar.
DADOS=$(git diff --cached --name-only --diff-filter=ACM | grep '^data/' || true)
if [ -n "$DADOS" ]; then
  echo ""
  echo "  ⚠  Há ficheiros de DADOS LOCAIS neste commit:"
  echo "$DADOS" | sed 's/^/       /'
  echo ""
  echo "     No repositório estes ficheiros são VAZIOS de propósito ([] / {}):"
  echo "     o que estiver lá dentro reaparece a cada deploy por cima do que"
  echo "     foi escrito, e um checkout apaga os rascunhos locais de quem"
  echo "     trabalha sem base de dados. Se não foi de propósito:"
  echo ""
  echo "         git restore --staged data/ && git checkout -- data/"
  echo ""
fi

npx lint-staged
